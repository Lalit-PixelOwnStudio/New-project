# Public URL of the site (used for metadata, auth callbacks and links).
NEXT_PUBLIC_SITE_URL=https://truehand.app

# Postgres connection string (Neon's pooled URL works). Required in production;
# the build applies migrations to it. Leave empty in development to use the
# embedded PGlite database in .data/ (created automatically).
DATABASE_URL=

# Auth (Better Auth). Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://truehand.app
# Optional Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email for sign-in codes (Resend). Without a key, codes are printed to the server log.
RESEND_API_KEY=
EMAIL_FROM="Truehand <hello@truehand.app>"

# Razorpay: payments from India in INR (UPI, cards, net banking).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# PayPal: payments from everywhere else in USD. PAYPAL_ENV=sandbox|live
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Google AdSense (leave empty until the account is approved).
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_EDITOR=
NEXT_PUBLIC_ADSENSE_SLOT_EXPORT=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE=
NEXT_PUBLIC_ADSENSE_SLOT_BANNER=
# Until AdSense is live, ad spaces show as labelled placeholders. Set to 0 to hide them.
NEXT_PUBLIC_AD_PLACEHOLDERS=

# Business details shown on the legal, refund and contact pages.
NEXT_PUBLIC_BUSINESS_NAME=
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_BUSINESS_PHONE=
NEXT_PUBLIC_BUSINESS_COUNTRY=India
NEXT_PUBLIC_SUPPORT_EMAIL=hello@truehand.app
